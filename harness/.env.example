ANTHROPIC_API_KEY=
# Required for identity-linked / org-wide keys. Skip if the key is already workspace-scoped.
# Find it at https://console.anthropic.com/settings/workspaces (looks like wrkspc_...)
ANTHROPIC_WORKSPACE_ID=

# Required role models (provider/model). Change these to switch models.
ORCHESTRATOR_MODEL=anthropic/claude-sonnet-4-6
EXPLORER_MODEL=anthropic/claude-haiku-4-5
EXECUTOR_MODEL=anthropic/claude-sonnet-4-6
REVIEWER_MODEL=anthropic/claude-opus-4-6

# Default target repo (optional). CLI path or --cwd overrides this.
HARNESS_CWD=/absolute/path/to/your/project

# Audit logs written to HARNESS_LOG_DIR/<runId>.json
HARNESS_LOG_DIR=/Users/daniel/Projects/daniel-workspace/.harness/runs

# Tool trace on stderr. Default off; set to 1 to debug [tool] call/result lines.
HARNESS_SHOW_TOOL_TRACE=0

# Executor plan approval. interactive (default): approve each executor plan in the terminal.
# background: no prompt, for CI or scripted runs. interactive without a TTY refuses to run the executor.
HARNESS_PLAN_APPROVAL=interactive
