{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "types": ["node", "vitest/globals"],
    "lib": ["ES2022"]
  },
  "include": ["src/**/*.ts", "playwright.config.ts", "vitest.config.ts"],
  "exclude": ["node_modules", "dist", "test-results", "playwright-report"]
}

