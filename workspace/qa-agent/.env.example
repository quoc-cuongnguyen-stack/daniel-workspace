# SSL Web Application Target Base URL
SSL_BASE_URL=http://localhost:8001

# Test User Credentials (REQUIRED for E2E tests)
SSL_TEST_USER=qa_test_user@example.com
SSL_TEST_PASSWORD=YourSecureTestPassword123!

# LLM API Configuration for Bug Report Generation (OPTIONAL)
# If omitted, bug reports will still be generated locally using a fallback template.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash


